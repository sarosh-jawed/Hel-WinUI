<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ESU / library-friendly accents -->
    <SolidColorBrush x:Key="AccentGoldBrush" Color="#FFCC00"/>
    <SolidColorBrush x:Key="AccentGoldForegroundBrush" Color="#111111"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#111827"/>
    <SolidColorBrush x:Key="SidebarForegroundBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="SidebarMutedForegroundBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SidebarActiveForegroundBrush" Color="#FFCC00"/>

    <!-- Main shell / content -->
    <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#F3F4F6"/>

    <!-- Card styling -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#374151"/>
    <SolidColorBrush x:Key="ContentForegroundBrush" Color="#F9FAFB"/>
    <SolidColorBrush x:Key="ContentMutedForegroundBrush" Color="#D1D5DB"/>

    <!-- Page headings -->
    <SolidColorBrush x:Key="PageTitleBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="PageSubtitleBrush" Color="#374151"/>

    <!-- Step states -->
    <SolidColorBrush x:Key="CompletedStepBrush" Color="#86EFAC"/>

    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ShellPadding">16</Thickness>
</ResourceDictionary>
