  "CsvColumns": {
    "LibraryName": "loclibrary.name",
    "LocationCode": "effective_location.code",
    "LocationName": "effective_location.name",
    "Title": "instances.title",
    "Barcode": "items.barcode",
    "EffectiveCallNumber": "items.effective_call_number",
    "HoldingsCallNumber": "holdings.call_number"
  },
  "LibraryRules": [
    {
      "LibraryName": "William Allen White Library",
      "RecipientKey": "wawl"
    }
  ],
  "LocationRules": [
    {
      "Key": "wawl-stacks",
      "LibraryName": "William Allen White Library",
      "LocationCodes": [ "stacks" ],
      "LocationNames": [],
      "RecipientKey": "wawl"
    }
  ],
  "CallNumberRules": [
    {
      "Key": "music-prefix",
      "LibraryName": "William Allen White Library",
      "MatchMode": "StartsWith",
      "Prefix": "M",
      "RangeStart": null,
      "RangeEnd": null,
      "RecipientKey": "wawl"
    },
    {
      "Key": "dewey-000-099",
      "LibraryName": "William Allen White Library",
      "MatchMode": "DeweyRange",
      "Prefix": null,
      "RangeStart": 0,
      "RangeEnd": 99.999,
      "RecipientKey": "wawl"
    }
  ],
  "CallNumberNormalization": {
    "StripPrefixes": [ "REF", "Q", "R" ]
  },
  "Recipients": [
    {
      "Key": "wawl",
      "DisplayName": "William Allen White Library",
      "Email": ""
    }
  ],
  "Output": {
    "Root": "%LOCALAPPDATA%\\Hel\\Output",
    "LogsRoot": "%DOCUMENTS%\\Hel\\Logs",
    "MonthFolderFormat": "yyyy-MM",
    "UnassignedFileName": "Unassigned.txt",
    "RunSummaryFileName": "RunSummary.txt"
  },
  "TextTemplate": {
    "GreetingLine": "Hello here are the titles in your area that have been missing or lost",
    "CountLineTemplate": "Count: {Count}",
    "HeaderLine": "Title | Barcode | Call number",
    "BulletPrefix": "*",
    "RecipientFileLineTemplate": "{Title} | {Barcode} | {CallNumber}",
    "UnassignedFileLineTemplate": "{Title} | {Barcode} | {CallNumber}",
    "ClosingLine": "Thanks,",
    "SignatureLine": "John",
    "SummaryHeader": "Hel Run Summary"
  }
}
